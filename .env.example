# Envoi du formulaire de contact (/contact) via l'API Resend (https://resend.com)
# Sans ces variables, le formulaire reste fonctionnel côté visiteur mais affiche
# un message invitant à contacter l'entreprise par téléphone/email à la place.

# Clé API Resend (Dashboard Resend > API Keys)
RESEND_API_KEY=

# Adresse qui reçoit les demandes de devis
CONTACT_TO_EMAIL=contact@epluchleg.fr

# Adresse expéditrice — doit appartenir à un domaine vérifié dans Resend
CONTACT_FROM_EMAIL="EPLUCH'LEG <contact@epluchleg.fr>"
